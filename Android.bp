package {
    default_applicable_licenses: ["external_jpegxl_license"],
}

license {
    name: "external_jpegxl_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-BSD-3-Clause",
    ],
    license_text: [
        "LICENSE",
        "PATENTS",
    ],
}

cc_library {
    name: "libjxl",
    host_supported: true,
    vendor_available: true,
    cflags: [
        "-DJPEGXL_ENABLE_SKCMS=1",
    ],
    sanitize: {
        all_undefined: true,
    },
    lto: {
        never: true,
    },
    export_include_dirs: [
        "lib/include",
        "gen/include",
    ],
    local_include_dirs: [
        "lib/include",
        "gen/include",
    ],
    srcs: [
        ":libjxl_dec_sources",
        ":libjxl_dec_box_sources",
        ":libjxl_dec_jpeg_sources",
        ":libjxl_enc_sources",
        ":libjxl_threads_sources",
        "lib/jxl/cms/jxl_cms.cc",
    ],
    shared: {
        static_libs: [
            "libhwy",
            "libbrotli",
        ],
    },
    static: {
        whole_static_libs: [
            "libhwy",
            "libbrotli",
        ],
    },
    whole_static_libs: [
        "libskia_skcms",
    ],
    visibility: [
        ":__subpackages__",
        "//external/dng_sdk:__subpackages__",
    ],
    sdk_version: "current",
    stl: "c++_shared",
}

